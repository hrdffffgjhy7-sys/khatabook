# Copy this file to .env and change every secret before using real data.

PORT=4000
NODE_ENV=development

# Leave DATABASE_PATH empty to use ./data/hisab-kitab.sqlite
DATABASE_PATH=
DATA_DIR=

# Recommended: a long random string (32+ characters).
# If empty, the server generates and stores one in data/.jwt-secret
JWT_SECRET=

# Session lifetime in hours
SESSION_HOURS=12

# Optional first-run admin. If omitted, the app shows a secure first-run setup screen.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Imran Arain

# Set to true only when the app is served over HTTPS
COOKIE_SECURE=false

# Browser origin during development (Vite runs on 5173)
CLIENT_ORIGIN=http://localhost:5173

# Automatic backups (Asia/Karachi timezone)
AUTO_BACKUP=true
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=30

# Maximum uploaded backup size in MB
MAX_BACKUP_MB=200

# Set to false if you do not want to serve the built React app from Express
SERVE_CLIENT=true
